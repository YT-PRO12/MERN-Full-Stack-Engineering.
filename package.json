{
  "name": "mern-full-stack-engineering",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "01-react-fundamentals",
    "02-react-patterns",
    "04-express-apis",
    "05-mongodb-and-mongoose",
    "06-full-stack-projects/campushub/api",
    "06-full-stack-projects/campushub/web"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch 06-full-stack-projects/campushub/api/src/server.js",
    "dev:web": "npm run dev -w @mern/campushub-web",
    "dev:fundamentals": "npm run dev -w @mern/react-fundamentals",
    "dev:patterns": "npm run dev -w @mern/react-patterns",
    "demo": "node scripts/demo.js",
    "seed": "node --env-file-if-exists=.env 06-full-stack-projects/campushub/api/src/seed-cli.js",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:node && npm run test:react",
    "test:node": "node --test 03-nodejs-fundamentals/*.test.js 04-express-apis/*.test.js 05-mongodb-and-mongoose/*.test.js 06-full-stack-projects/campushub/api/test/*.test.js",
    "test:react": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.28.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  }
}
